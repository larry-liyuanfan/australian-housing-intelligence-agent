{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "analysis": {
      "analyzer": {
        "housing_text_analyzer": {
          "type": "standard",
          "stopwords": "_english_"
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "doc_id": {
        "type": "keyword"
      },
      "platform": {
        "type": "keyword"
      },
      "source": {
        "type": "keyword",
        "ignore_above": 512
      },
      "query_keyword": {
        "type": "keyword",
        "ignore_above": 512
      },
      "title": {
        "type": "text",
        "analyzer": "housing_text_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 512
          }
        }
      },
      "text": {
        "type": "text",
        "analyzer": "housing_text_analyzer"
      },
      "created_at": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "collected_at": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "url": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "city_context": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "topic": {
        "type": "keyword",
        "ignore_above": 256
      },
      "australia_connection": {
        "type": "keyword",
        "ignore_above": 512
      },
      "housing_relevant": {
        "type": "boolean"
      },
      "sentiment": {
        "type": "float"
      },
      "sentiment_label": {
        "type": "keyword",
        "ignore_above": 64
      },
      "subjectivity": {
        "type": "float"
      },
      "sentiment_text_chars": {
        "type": "integer"
      },
      "subtopic": {
        "type": "keyword",
        "ignore_above": 512
      },
      "language": {
        "type": "keyword",
        "ignore_above": 64
      },
      "keywords": {
        "type": "keyword",
        "ignore_above": 256
      },
      "raw_metadata": {
        "type": "object",
        "enabled": false
      },
      "content_type": {
        "type": "keyword"
      },
      "parent_id": {
        "type": "keyword"
      },
      "video_id": {
        "type": "keyword"
      },
      "channel_title": {
        "type": "keyword"
      },
      "like_count": {
        "type": "integer"
      }
    }
  }
}
