HOUSING_BACKEND=local
HOUSING_CACHE=memory
HOUSING_MAX_TOOL_CALLS=4
HOUSING_TOOL_TIMEOUT_SECONDS=3.0
HOUSING_TRACE_LIMIT=1000

# Elasticsearch/Redis are optional. Local deterministic adapters are the default.
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_API_KEY=
REDIS_URL=redis://redis:6379/0

# Alibaba Cloud Model Studio: all credentials remain environment-only.
# Example Singapore compatible endpoint:
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_CHAT_MODEL=qwen-plus
MODEL_STUDIO_EMBEDDING_MODEL=text-embedding-v4
MODEL_STUDIO_RERANK_MODEL=qwen3-rerank
MODEL_STUDIO_RERANK_PATH=/reranks
